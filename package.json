{
  "name": "@dbm/cli",
  "version": "0.1.0",
  "description": "Database Migration Manager - CLI independiente para gestionar migraciones estructurales, cambios de datos y seeds en múltiples motores (PostgreSQL, MongoDB) y múltiples proyectos.",
  "license": "MIT",
  "bin": {
    "dbm": "./dist/cli/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node src/cli/cli.ts",
    "start": "node dist/cli/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "dotenv": "^18.0.5",
    "js-yaml": "^4.1.0",
    "mongodb": "^6.10.0",
    "pg": "^8.13.1",
    "semver": "^7.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "@types/semver": "^7.5.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
